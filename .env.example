# Supabase (https://supabase.com) – Project Settings → API
# Másolás: .env.local  (a .env.local a gitbe nem kerül, lásd .gitignore)

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# A `supabase/migrations` fájlban létrehozott demo csoport UUID-ja
VITE_DEFAULT_GROUP_ID=b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a02

# Auth mód: none | keycloak | desktop
VITE_AUTH_MODE=keycloak

# Keycloak SPA kliens
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=gyumolcsnaptar
VITE_KEYCLOAK_CLIENT_ID=gyumolcsnaptar-web

# Desktop módhoz (Keycloak nélküli gateway token)
VITE_DESKTOP_ACCESS_TOKEN=change-me-desktop-token

# ── Értesítések ──────────────────────────────────────────────────────────────

# Resend (https://resend.com) – email értesítések
# Supabase Edge Function secret-ként is be kell állítani (supabase secrets set ...)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Gyümölcsnaptár <noreply@gyuminaptar.hu>

# VAPID kulcspár Web Push értesítéshez
# Generálás: npx web-push generate-vapid-keys
# Supabase Edge Function secret-ként is be kell állítani
VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:admin@gyuminaptar.hu

# VAPID publikus kulcs a frontend-en (ugyanaz mint VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Napi gyümölcs-emlékeztető cron híváshoz (Edge Function Authorization headerben)
CRON_SECRET=change-me-cron-secret
